{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "siyuanjiang-personal-space",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "siyuanjiang-db",
      "database_id": "89552b08-4a1c-4f3c-bf1f-8901740c355e",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "siyuanjiang-files"
    }
  ]
}
